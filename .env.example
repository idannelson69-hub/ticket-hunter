# ===== צייד כרטיסים — קובץ הגדרות =====
# העתק לקובץ בשם .env ומלא את הערכים. לעולם אל תעלה את .env לאינטרנט / GitHub.

# --- כניסה לממשק (חובה) ---
ADMIN_PASSWORD=בחר-סיסמה-ארוכה-וחזקה
# מחרוזת אקראית של 32 תווים ומעלה (אפשר ליצור: python -c "import secrets;print(secrets.token_urlsafe(32))")
SESSION_SECRET=
# true כשהאתר רץ מאחורי HTTPS (בפריסה בענן עם Caddy)
COOKIE_SECURE=true

# --- Telegram (ראה docs/מדריך-התקנה.md, שלב 2) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- מייל (Gmail: צריך "סיסמת אפליקציה" מ-myaccount.google.com/apppasswords) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=

# --- Ticketmaster Discovery API — מפתח חינמי מ-developer.ticketmaster.com ---
TICKETMASTER_API_KEY=
TICKETMASTER_DAILY_QUOTA=5000

# --- ניטור ---
# עמודי אינטרנט רשמיים: לא פחות מ-300 שניות בין בדיקות
MIN_PAGE_WATCH_SECONDS=300
CRITICAL_AFTER_FAILURES=5

# מצב דמה: מוסיף אירוע דמה מסומן לבדיקת המערכת (false בשימוש אמיתי)
DEMO_MODE=false

# --- פריסה בענן ---
# הדומיין שלך (לתעודת HTTPS אוטומטית של Caddy). למשל: tickets.example.com
DOMAIN=
DATABASE_URL=sqlite:////data/tickets.db

# false = בלי סיסמה רק בגישה מהמחשב עצמו (localhost). בשרת ענן להשאיר true.
REQUIRE_LOGIN=true
